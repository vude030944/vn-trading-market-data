# ===========================================================================
# Copy to .env and fill in. Do NOT commit .env.
# ===========================================================================

# --- Shared infrastructure -------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=redpanda-0:9092,redpanda-1:9092,redpanda-2:9092
KAFKA_ACKS=all
KAFKA_COMPRESSION=zstd
LOG_LEVEL=INFO
RUN_ENV=dev
# Empty disables telemetry. Point at an OTel collector if one is running.
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- SSI -------------------------------------------------------------------
SSI_ENABLED=1
SSI_API_KEY=
SSI_API_SECRET=
# Section 10.3: the docs never say how the token is passed. Try query -> header -> frame
SSI_AUTH_MODE=query
# Section 10.1: two conflicting endpoints; the other is wss://stream.ssi.com.vn
SSI_STREAM_URL=wss://stream.ssi.com.vn/ws/v3
# Section 10.6: flip this on if the live stream actually demands OTP
SSI_REQUIRE_OTP=0
SSI_OTP=
SSI_KAFKA_TOPIC=ssi.data.raw.market

# --- DNSE ------------------------------------------------------------------
DNSE_ENABLED=1
DNSE_API_KEY=
DNSE_API_SECRET=
DNSE_ENCODING=json
DNSE_API_VERSION=2026-05-07
DNSE_CHANNELS=tick_extra,top_price,foreign,session
DNSE_BOARD_ID=G1
DNSE_SYMBOLS_FILE=
DNSE_SYMBOLS=ACB,HPG,VNM,FPT,TCB
DNSE_SHARD_INDEX=0
DNSE_SHARD_COUNT=1
DNSE_KAFKA_TOPIC=dnse.data.raw.market

# --- TCBS ------------------------------------------------------------------
# The token lives 8 HOURS and has NO refresh token. Two options:
#   (a) paste a token you already obtained into TCBS_TOKEN
#   (b) let the service exchange API key + OTP for one at startup
TCBS_TOKEN=
TCBS_API_KEY=
TCBS_OTP=
TCBS_STOCK_ENABLED=1
TCBS_DERIVATIVE_ENABLED=1
TCBS_OURANOS_ENABLED=1
TCBS_FUTURES_SYMBOLS=41I1G8000
TCBS_SYMBOLS_FILE=
TCBS_OURANOS_SYMBOLS_FILE=
TCBS_OURANOS_TICKERS=TCB,FPT,HPG
# `dtn` unlocks channel s|42 (the 10-level depth book) — undocumented but real
TCBS_DERIV_CHANNELS=bp,bi,tm,mp,op,fe,dtn
