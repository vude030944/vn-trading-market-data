# ============================================================================
# Redpanda — PROD
# ============================================================================
DATA_ROOT=/var/lib/vnmd/prod            # <<< FILL IN: a high-IOPS volume, NOT shared with the OS

RP_IMAGE=redpandadata/redpanda:v26.1.16
CONSOLE_IMAGE=redpandadata/console:v3.10.0

# Redpanda recommends ~2 GB per core. These are the MINIMUM values for prod.
RP_MEM_LIMIT=5g
RP_SEASTAR_MEM=4G
RP_SMP=2
RP_CPUS=2.0

CONSOLE_MEM_LIMIT=512m
CONSOLE_CPUS=0.5

# The hostname EXTERNAL CLIENTS use to connect. Get this wrong and a client
# reaches the first broker then hangs, because the metadata returns addresses it
# cannot route to.
RP_ADVERTISE_HOST=kafka.prod.internal   # <<< FILL IN

# Authentication. Dev runs PLAINTEXT; prod MUST enable this.
RP_SASL_ENABLED=true
RP_SUPERUSER=vnmd-admin                 # <<< FILL IN
RP_SUPERUSER_PASSWORD=                  # <<< FILL IN (from the secret manager)

# Longer retention than dev: prod needs room to replay when a parser bug surfaces.
RETENTION_BYTES=2147483648              # 2 GiB per partition
RETENTION_MS=604800000                  # 7 days
