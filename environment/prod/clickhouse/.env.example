# ============================================================================
# ClickHouse — PROD
# ============================================================================
DATA_ROOT=/var/lib/vnmd/prod            # <<< FILL IN
CH_IMAGE=clickhouse:26.7.3.19

# Tune to the real machine. ClickHouse reads cgroup limits, so setting it here is enough.
CH_MEM_LIMIT=16g
CH_CPUS=6.0

CH_DB=vnmd
CH_USER=vnmd
CH_PASSWORD=                            # <<< FILL IN (secret manager)
