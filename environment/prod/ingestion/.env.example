# ============================================================================
# Ingestion — PROD.  Do NOT commit the real .env.
# ============================================================================
IMAGE=ghcr.io/<org>/vnmd-ingestion:0.1.0   # <<< FILL IN (build & push from src/ingestion)

KAFKA_BOOTSTRAP_SERVERS=redpanda-0:9092,redpanda-1:9092,redpanda-2:9092
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_SASL_USERNAME=vnmd-ingestion         # <<< FILL IN
KAFKA_SASL_PASSWORD=                       # <<< FILL IN
KAFKA_ACKS=all
KAFKA_COMPRESSION=zstd

RUN_ENV=prod
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# --- SSI ---
SSI_API_KEY=                               # <<< FILL IN
SSI_API_SECRET=                            # <<< FILL IN
# The three values below are UNVERIFIED ASSUMPTIONS (the SSI docs are ambiguous).
# Confirm them against the live endpoint before trusting them —
# docs/ssi/brief/DOCUMENT.md section 10.
SSI_AUTH_MODE=query
SSI_STREAM_URL=wss://stream.ssi.com.vn/ws/v3
SSI_REQUIRE_OTP=0
# SSI subscribes by TOPIC PATTERN, not by symbol list ('*' means every symbol
# within the key's permissions) -> there is no SSI_SYMBOLS_FILE.
SSI_TOPICS=trade.*@tick,quote.*@tick,room.*@tick,put.*@tick,oddlot.*@tick,market.*

# --- DNSE ---
DNSE_API_KEY=                              # <<< FILL IN
DNSE_API_SECRET=                           # <<< FILL IN
DNSE_ENCODING=msgpack                      # prod uses msgpack to save bandwidth
DNSE_API_VERSION=2026-05-07                # pin explicitly; do not let the server fall back
DNSE_SYMBOLS_FILE=/app/symbols/dnse.txt
DNSE_SHARD_INDEX=0
DNSE_SHARD_COUNT=1

# --- TCBS ---
# The token lives 8 HOURS and has NO refresh token -> a re-provisioning procedure
# is required. The service warns 30 minutes ahead; see environment/prod/README.md section 4.
TCBS_TOKEN=                                # <<< FILL IN (or API_KEY + OTP)
TCBS_API_KEY=
TCBS_OTP=
TCBS_SYMBOLS_FILE=/app/symbols/tcbs.txt
TCBS_OURANOS_SYMBOLS_FILE=/app/symbols/tcbs.txt
TCBS_FUTURES_SYMBOLS=41I1G8000
