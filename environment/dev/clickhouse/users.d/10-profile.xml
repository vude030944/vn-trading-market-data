<?xml version="1.0"?>
<!-- Per-query limits so one bad SELECT cannot take the container down. -->
<clickhouse>
    <profiles>
        <default>
            <max_memory_usage>2147483648</max_memory_usage>        <!-- 2 GiB per query -->
            <max_bytes_before_external_group_by>1073741824</max_bytes_before_external_group_by>
            <max_bytes_before_external_sort>1073741824</max_bytes_before_external_sort>
            <max_threads>4</max_threads>
            <max_execution_time>300</max_execution_time>
        </default>
    </profiles>
</clickhouse>
