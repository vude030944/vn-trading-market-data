# PROD-VM stack — EXAMPLE only. Copy to `.env` and fill real credentials.
# `.env` is gitignored and must NEVER be committed.
KAFKA_BOOTSTRAP_SERVERS=redpanda-0:9092,redpanda-1:9092,redpanda-2:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_ACKS=all
KAFKA_COMPRESSION=zstd
RUN_ENV=prod
LOG_LEVEL=INFO
SERVICE_NAME=vnmd-ingestion
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_EVERY_N_FRAMES=5000

# --- ClickHouse ---
CH_DB=vnmd
CH_USER=vnmd
CH_PASSWORD=change-me-strong-password

# --- SSI (FastConnect v3) ---
SSI_ENABLED=1
SSI_API_KEY=put-your-ssi-api-key-here
SSI_API_SECRET=put-your-ssi-api-secret-here
SSI_API_URL=https://api.ssi.com.vn
SSI_STREAM_URL=wss://stream.ssi.com.vn/ws/v3
SSI_AUTH_MODE=query
SSI_REQUIRE_OTP=0
SSI_EXPIRES_AT_UNIT=auto
SSI_TOPICS=trade.*@tick,quote.*@tick,room.*@tick,put.*@tick,oddlot.*@tick,market.*
SSI_PING_INTERVAL_S=30
SSI_KAFKA_TOPIC=ssi.data.raw.market

# --- DNSE (LightSpeed) ---
# NOTE: keep the channel list small — the normalUser tier caps at 200 channels
# and each symbol x channel counts. 4 channels x ~64 symbols fits comfortably.
DNSE_ENABLED=1
DNSE_API_KEY=put-your-dnse-api-key-here
DNSE_API_SECRET=put-your-dnse-api-secret-here
DNSE_STREAM_URL=wss://ws-openapi.dnse.com.vn/v1/stream
DNSE_API_VERSION=2026-05-07
DNSE_ENCODING=json
DNSE_CHANNELS=tick_extra,foreign,session,market_index
DNSE_BOARD_ID=G1
DNSE_PRODUCT_GROUP_ID=STO
DNSE_RESOLUTIONS=1
DNSE_MARKET_INDICES=VNINDEX,VN30,HNX,UPCOM
DNSE_SYMBOLS=ACB,BCM,BID,BVH,CTG,FPT,GAS,GVR,HDB,HPG,MBB,MSN,MWG,PLX,POW,SAB,SHB,SSB,SSI,STB,TCB,TPB,VCB,VHM,VIB,VIC,VJC,VNM,VPB,VRE
DNSE_PING_INTERVAL_S=25
DNSE_CONN_MAX_LIFETIME_S=28800
DNSE_CONN_RENEW_LEAD_S=300
DNSE_KAFKA_TOPIC=dnse.data.raw.market

# --- TCBS (iFlash; token ~24h, NO refresh — re-mint via OTP when it expires) ---
TCBS_ENABLED=1
TCBS_REST_URL=https://openapi.tcbs.com.vn
TCBS_WS_URL=wss://openapi.tcbs.com.vn
TCBS_API_KEY=put-your-tcbs-api-key-here
TCBS_OTP=
TCBS_TOKEN=put-your-current-tcbs-jwt-here
TCBS_TOKEN_TTL_S=28800
TCBS_TOKEN_REFRESH_LEAD_S=1800
TCBS_STOCK_CHANNELS=bp,bi,tm,mp,op,fe
TCBS_FLOORS=1,2,3,4,5,7,8,9
TCBS_INDICES=1,2,3,4,5,7,8,9
TCBS_PT_FLOORS=1,2,3
TCBS_SYMBOLS=ACB,BCM,BID,BVH,CTG,FPT,GAS,GVR,HDB,HPG,MBB,MSN,MWG,PLX,POW,SAB,SHB,SSB,SSI,STB,TCB,TPB,VCB,VHM,VIB,VIC,VJC,VNM,VPB,VRE
TCBS_FUTURES_SYMBOLS=41I1G8000,41I1G9000,41I1GC000
TCBS_OURANOS_CODES=C001,C002S60,C002S900
TCBS_OURANOS_TICKERS=ACB,BCM,BID,BVH,CTG,FPT,GAS,GVR,HDB,HPG,MBB,MSN,MWG,PLX,POW,SAB,SHB,SSB,SSI,STB,TCB,TPB,VCB,VHM,VIB,VIC,VJC,VNM,VPB,VRE
TCBS_STOCK_KAFKA_TOPIC=tcbs.data.raw.stock
TCBS_DERIV_KAFKA_TOPIC=tcbs.data.raw.future
TCBS_OURANOS_KAFKA_TOPIC=tcbs.data.raw.ouranos
