# Secrets — NEVER commit these
.env
**/.env
!**/.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# Generated by the container (the ClickHouse entrypoint writes this when CLICKHOUSE_USER is set)
environment/*/clickhouse/users.d/default-user.xml

# Auto-generated symbol universes (vn30.txt is a hand-maintained seed — KEEP it)
src/ingestion/symbols/ssi.txt
src/ingestion/symbols/dnse.txt
src/ingestion/symbols/tcbs.txt

# Flink job build output (make transform-build copies the jar into flink/jobs)
src/transform/build/
src/transform/.gradle/
environment/*/flink/jobs/

# Data (lives outside the repo on Data_HDD — this is a guard in case someone points it here)
data/
*.log

# IDE / OS
.idea/
.vscode/
.DS_Store
